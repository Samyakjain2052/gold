# ---------------------------------------------------------------------------
# Bullion Rates Platform — example environment
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Full documentation: docs/env-reference.md
#
# Defaults below run the whole stack locally with NO vendor account and NO cost.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
API_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
# Comma-separated. A literal "*" is rejected when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# The APPLICATION connects as a NON-SUPERUSER, NON-OWNER role. PostgreSQL
# exempts superusers from row-level security and lets table owners bypass their
# own policies, so connecting as either would silently disable every
# tenant-isolation policy while appearing to work perfectly.
DATABASE_URL=postgresql://bullion_app:devpassword@localhost:5432/bullion

# MIGRATIONS connect as the owner, which needs DDL rights the app role lacks.
# Used only by the Prisma CLI — never by the running service.
DATABASE_MIGRATION_URL=postgresql://bullion_owner:devpassword@localhost:5432/bullion

# MAINTENANCE connects as bullion_maintenance: BYPASSRLS, but granted
# SELECT+DELETE on `idempotency_keys` and NOTHING else. Read only by the
# cleanup job (`npm run maintenance:purge-idempotency`), never by the API.
#
# There is deliberately no fallback to the other two URLs. The app role would
# delete nothing (RLS hides every row from a context-less session); the admin
# role works locally only because Docker makes it a superuser, and would match
# zero rows on Azure. Both failures are silent, so neither is offered.
DATABASE_MAINTENANCE_URL=postgresql://bullion_maintenance:devpassword@localhost:5432/bullion

DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Idempotency retention (cleanup job only; the API does not read these) ---
# A stored response is ACTIVE until it is this old — a retry within the window
# replays it instead of re-executing. After that the key is forgotten and a
# retry executes again. 48h is the upper end of api-standards.md §6.
IDEMPOTENCY_RETENTION_HOURS=48
IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000
IDEMPOTENCY_CLEANUP_MAX_BATCHES=100

# --- Redis -----------------------------------------------------------------
# docker-compose maps Redis to host port 6380 by default, since 6379 is often
# already taken by another project. Override REDIS_HOST_PORT to change it.
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=bullion:

# --- Authentication (Microsoft Entra External ID) ---------------------------
# Production REFUSES TO BOOT without AUTH_ISSUER, AUTH_AUDIENCE and
# AUTH_DIRECTORY_ID. There is deliberately no development bypass — no flag
# disables verification, so none can be left on by accident. For local work,
# point these at your own Entra External ID tenant.
#
# Leave BLANK until the External ID tenant exists. Do not guess these values:
# a wrong issuer or audience silently accepts tokens meant for something else.

# Expected `iss`. Entra v2.0 issuers look like:
#   https://<subdomain>.ciamlogin.com/<directory-guid>/v2.0   (External ID)
#   https://login.microsoftonline.com/<directory-guid>/v2.0    (workforce)
AUTH_ISSUER=

# Expected `aud` — this API's Application ID URI, e.g. api://bullion-rates
AUTH_AUDIENCE=

# Expected `tid`. Pins tokens to OUR directory. Without it, a validly signed
# token from ANY other Entra directory carrying our audience is accepted —
# Microsoft calls this the confused-deputy problem.
AUTH_DIRECTORY_ID=

# Explicit JWKS URL. Derived from AUTH_ISSUER when blank.
AUTH_JWKS_URL=

# Client app ids (`azp`) permitted to call this API. Blank = any in-directory
# client. Set it once the web app registration exists.
AUTH_ALLOWED_CLIENT_IDS=

# Permitted signing algorithms. Must be ALL-asymmetric or ALL-symmetric —
# mixing them enables algorithm confusion (a public key replayed as an HMAC
# secret), and startup validation rejects such a list. `none` is never allowed.
# RS256 verified against the live Entra discovery document.
AUTH_JWT_ALGORITHMS=RS256

# Tolerated clock skew on exp/nbf. Small on purpose: it widens the window in
# which an expired token is still accepted.
AUTH_CLOCK_TOLERANCE_S=5
# Reject tokens claiming to be issued further ahead than this.
AUTH_MAX_FUTURE_IAT_S=60
# Absolute age cap regardless of `exp`. 0 disables it.
AUTH_MAX_TOKEN_AGE_S=0

# JWKS cache. See docs/authentication.md for why these values.
#   cache_max_age : how long a key set is used before refresh
#   cooldown      : minimum gap between refreshes triggered by an unknown `kid`
#                   — `kid` is attacker-controlled, so without this a flood of
#                   forged kids becomes a DoS against the identity provider
#   stale_grace   : how long known-good keys keep being served when refreshes
#                   are failing, so a provider outage does not take auth down
AUTH_JWKS_CACHE_MAX_AGE_MS=600000
AUTH_JWKS_COOLDOWN_MS=30000
AUTH_JWKS_STALE_GRACE_MS=86400000
AUTH_JWKS_FETCH_TIMEOUT_MS=5000

# --- Market data -----------------------------------------------------------
# mock | goldprice_dev | metalprice_api | ibja | composite
# `mock` needs no API key, no account and no subscription.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
MARKET_DATA_SYMBOLS=XAU_INR,XAG_INR

# IBJA official API — required when provider is `ibja` or `composite`.
IBJA_API_KEY=
IBJA_BASE_URL=

# Polling below the provider's own refresh rate only burns quota.
MARKET_POLL_INTERVAL_MS=60000
MARKET_POLL_MARKET_HOURS_ONLY=true
MARKET_HOURS_IST=09:00-23:30

# Reject implausible ticks (vendors do emit zeroes and decimal-shifted values).
MARKET_RATE_SANITY_MAX_MOVE_BPS=500

# --- Freshness thresholds --------------------------------------------------
# Two thresholds, three states: fresh | stale | expired.
# Defaults are derived from the 60s poll interval, not picked for roundness:
#   stale   = 2 missed polls + margin  (one miss is jitter, two is a signal)
#   expired = 10 missed polls          (too old to quote a customer from)
# Raising these to mask a flaky feed means showing stale prices styled as live.
FRESHNESS_STALE_AFTER_MS=120000
FRESHNESS_EXPIRED_AFTER_MS=600000

# --- Realtime --------------------------------------------------------------
SSE_HEARTBEAT_MS=20000
SSE_MAX_CONNECTIONS_PER_REPLICA=5000
# Redis leader lock — guarantees exactly ONE poller cluster-wide, so provider
# call volume never scales with replica count.
MARKET_POLLER_LEADER_LOCK_TTL_MS=30000
MARKET_POLLER_ENABLED=true

# --- Storage ---------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_LOGOS=tenant-logos
# Local dev only. Production uses managed identity.
AZURE_STORAGE_CONNECTION_STRING=
LOGO_MAX_BYTES=2097152
# SVG is deliberately excluded — it is a script execution vector.
LOGO_ALLOWED_TYPES=image/png,image/jpeg,image/webp

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=300
RATE_LIMIT_LOGIN_PER_15MIN=10

# --- Observability ---------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_NAME=bullion-api

# ---------------------------------------------------------------------------
# Web (Next.js) — apps/web/.env.local
#
# EVERYTHING BELOW IS COMPILED INTO THE BROWSER BUNDLE AND IS WORLD-READABLE.
# No secret may appear here. The market-data API key lives only on the API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Entra public-client configuration. A public client id and authority ARE meant
# to be public — a browser app holds no client secret (PKCE instead).
NEXT_PUBLIC_AUTH_AUTHORITY=
NEXT_PUBLIC_AUTH_CLIENT_ID=
NEXT_PUBLIC_AUTH_SCOPES=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
