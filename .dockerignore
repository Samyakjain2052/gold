# Keep the build context small and, more importantly, keep secrets and local
# state out of it. Anything listed here cannot end up in an image layer even by
# accident.

.env
.env.*
!.env.example

.git
.github
node_modules
**/node_modules
**/dist
**/coverage
**/coverage-*
**/*.tsbuildinfo

# Tests are not part of the runtime image; the build stage does not need them.
apps/api/tests

docs
infra
*.md
!readme.md

.vscode
.idea
.DS_Store
docker-compose.yml
