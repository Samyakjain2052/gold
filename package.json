{
  "name": "bullion-rates-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant live bullion rate platform for Indian jewellery shops",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace apps/api",
    "test:coverage": "npm run test:coverage --workspace apps/api",
    "test:isolation": "npm run test:isolation --workspace apps/api",
    "dev": "npm run dev --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:reset": "npm run db:reset --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "test:web": "npm run test --workspace apps/web"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "fsevents@2.3.3": true
  }
}
